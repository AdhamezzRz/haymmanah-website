# Resend API key for contact form email delivery
# Get one at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — analytics only loads once a visitor accepts the cookie banner,
# and only if these are set. Leave blank to keep analytics fully disabled.
# GA4 Measurement ID, e.g. G-XXXXXXXXXX — from Google Analytics > Admin > Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Meta Pixel ID — from Meta Events Manager
NEXT_PUBLIC_META_PIXEL_ID=

# ── Team portal (/portal) ────────────────────────────────────────────────
# Optional: secret for signing portal session cookies. If unset, one is
# generated once into data/portal/.secret on first run.
PORTAL_SECRET=
# Optional: where the embedded JSON store writes (default: ./data/portal)
PORTAL_DATA_DIR=
# Local development only — the first-admin account created during testing:
# PORTAL_DEV_EMAIL=admin@himna.sa
# PORTAL_DEV_PASSWORD=Haymanah-Dev-2026!

# Portal password-reset emails (optional). Needs a sender on a domain verified
# in Resend — the shared onboarding@resend.dev sender can't email the team.
# Without these, reset still works via admin links (WhatsApp) and owner recovery.
PORTAL_MAIL_FROM=
# Base URL used in emailed links if proxy headers are unreliable, e.g. https://himna.sa
PORTAL_PUBLIC_URL=
# Set to "off" to hide "اطلب الانضمام" (join requests) on the login page.
PORTAL_SIGNUP=
