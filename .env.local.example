# Resend API key for contact form email delivery
# Get one at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — analytics only loads once a visitor accepts the cookie banner,
# and only if these are set. Leave blank to keep analytics fully disabled.
# GA4 Measurement ID, e.g. G-XXXXXXXXXX — from Google Analytics > Admin > Data Streams
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Meta Pixel ID — from Meta Events Manager
NEXT_PUBLIC_META_PIXEL_ID=
